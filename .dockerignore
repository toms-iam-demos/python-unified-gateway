# Allow only the inputs required by the production Dockerfile.
**
!Dockerfile
!requirements.txt
!gateway/
!gateway/**
# Exclude accidental local state inside the application package too.
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/secrets/
**/data/
**/*.db
**/*.db-*
**/*.pem
**/*.key
**/*.bak
**/.DS_Store

# Exclude Finder sidecars and all common runtime SQLite variants.
**/._*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*

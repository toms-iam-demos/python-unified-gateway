@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam componentStyle rectangle
skinparam ArrowColor #075CA3
skinparam rectangleBorderColor #09283E
title Municipal procurement - explicit system boundaries
rectangle "Illustrative procurement ecosystem\n(not connected)" #F3F5F7 {
  [Sourcing portal\nSolicitations] as beacon
  [SAP Business Network\nSupplier transactions] as sap
}
rectangle "Proposed IAM integration\n(not implemented in this package)" #EAF3FB {
  [Workflow Builder\nIntake and review] as wf
  [eSignature\nExecution evidence] as es
  [Agreement Manager\nReviewed agreement metadata] as am
  wf --> es
  es --> am
}
rectangle "Implemented local demo" #EDF7F1 {
  [Browser / Swagger] as ui
  [PUG FastAPI\nEvidence + arithmetic + plans] as pug
  database "SQLite\nFixtures / audit / plans" as db
  [Simulated procurement inbox\nUnique command receipt] as inbox
  ui --> pug
  pug --> db
  pug --> inbox
}
am ..> pug : proposed typed adapter
wf ..> pug : proposed HTTP extension
inbox ..> sap : future adapter discovery\nnot a certified SAP interface
beacon ..> wf : conceptual award reference
legend bottom
Solid = local implementation or proposed IAM relationship inside its labeled box.
Dotted = future integration boundary; no outbound requests implemented.
endlegend
@enduml
